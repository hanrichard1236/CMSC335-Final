<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <title>Recipe Results</title>
        <link rel="stylesheet" href="/css/styles.css" />
        <link
            href="https://fonts.googleapis.com/css?family=Tangerine"
            rel="stylesheet"
        />
    </head>
    <body>
        <header>
            <h1>📋 Recipes Found</h1>
            <nav>
                <a href="/">Home</a>
                <a href="/recipes/search">Search Recipes</a>
                <a href="/recipes/favorites">Saved Recipes</a>
            </nav>
        </header>

        <main id="results-container">
            <%- resultsHTML %>
        </main>

        <script>
            const serverHTML = `<%- resultsHTML %>`;
            if (serverHTML.trim() !== "") {
                localStorage.setItem("lastSearchResults", serverHTML);
            }

            else {
                const stored = localStorage.getItem("lastSearchResults");
                if (stored) {
                    document.getElementById("results-container").innerHTML = stored;
                }
                else{
                    document.getElementById("results-container").innerHTML = `<p class="empty-msg">No Recent Searches.</p>`;
                }
            }
        </script>
    </body>
</html>



