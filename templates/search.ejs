<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <title>Recipe Search</title>
        <link rel="stylesheet" href="/css/styles.css" />
        <link
            href="https://fonts.googleapis.com/css?family=Tangerine"
            rel="stylesheet"
        />
    </head>
    <body>
        <header>
            <h1>🔍 Find a Recipe</h1>
            <nav>
                <a href="/">Home</a>
                <a href="/recipes/search">Search Recipes</a>
                <a href="/recipes/favorites">Saved Recipes</a>
            </nav>
        </header>

        <main>
            <section class="intro">
                <h2>Search for Recipes</h2>
                <p>Find your next favorite meal from millions of recipes</p>

                <form
                    action="/recipes/results"
                    method="POST"
                    class="search-form"
                >
                    <input
                        type="text"
                        name="query"
                        placeholder="Search for a recipe..."
                        required
                    />
                    <button type="submit">Search</button>
                </form>
            </section>
        </main>
    </body>
</html>
